{
  "name": "stowken",
  "version": "0.1.0",
  "description": "Compressed, deduplicated storage for LLM token sequences",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "npm run build",
    "test": "node test.js"
  },
  "keywords": ["llm", "tokenizer", "storage", "dedup", "compression"],
  "license": "Apache-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "napi": {
    "binaryName": "stowken",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 16"
  }
}
